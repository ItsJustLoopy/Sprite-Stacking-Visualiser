<Window x:Class="Sprite_Stacking_Visualiser.MainWindow"  
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
       xmlns:local="clr-namespace:Sprite_Stacking_Visualiser"  
       xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"  
       mc:Ignorable="d"  
       Title="MainWindow" Height="600" Width="1000" Background="Black">


    <Border BorderBrush="White" BorderThickness="3" Margin="5,5,5,5">
        <Grid Margin="-37,-27,-37,-27">
            <Border BorderBrush="White" BorderThickness="2" Margin="347,78,243,77">
                <skia:SKElement x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface" Margin="41,27,41,27" />
            </Border>
            <Border BorderBrush="White" BorderThickness="2" Margin="100,77,755,327">
                <ListBox x:Name="Lbx_SpriteStacks" HorizontalContentAlignment="Center" Initialized="Lbx_SpriteStacks_Initialized" SelectionChanged="Lbx_SpriteStacks_SelectionChanged" Foreground="White" Background="{x:Null}" FontFamily="Sitka Banner Semibold" FontSize="16"  />

            </Border>
            <ListView x:Name="Lsv_Sprites" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="859,77,0,78" Initialized="Lsv_Sprites_Initialized" Foreground="Black" Background="Black" BorderBrush="White" HorizontalAlignment="Left">
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="Btn_Addstack" Content="Add Sprite Stack" Margin="100,312,755,0" VerticalAlignment="Top" Height="32" Foreground="White" Background="Black" BorderBrush="White" Click="Btn_Addstack_Click"/>
        </Grid>
    </Border>
</Window>
